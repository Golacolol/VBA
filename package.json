{
  "name": "vba",
  "private": true,
  "version": "0.5.0",
  "description": "VORTEX Basketball — menus, courts, and modes. On-court play comes later.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "node scripts/play.mjs",
    "build": "vite build && node scripts/inline-dist.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest",
    "data:nba": "node scripts/generate-nba-seed.mjs",
    "data:nba:rosters": "node scripts/refresh-nba-rosters.mjs",
    "data:leagues": "node scripts/generate-nba-seed.mjs",
    "data:results": "node scripts/refresh-nba-results.mjs",
    "data:bios": "node -e \"console.log('NBA bios refresh not wired yet')\"",
    "assets:crests": "node scripts/import-nba-emblems.mjs",
    "assets:emblems": "node scripts/import-nba-emblems.mjs",
    "assets:kits": "node scripts/import-kits.mjs",
    "assets:portraits": "node scripts/import-player-portraits.mjs",
    "assets:classic-portraits": "node scripts/import-classic-portraits.mjs",
    "data:squads": "node scripts/refresh-nba-rosters.mjs",
    "data:classic-ratings": "node scripts/refresh-classic-ratings.mjs",
    "assets:classic-crests": "node scripts/import-nba-emblems.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
